# ─────────────────────────────────────────────────────────────
# EventPulse — Environment Variables & Secrets
# ─────────────────────────────────────────────────────────────
# Copy this file to `.dev.vars` for local development.
# For production, set each secret via:
#   wrangler secret put STRIPE_SECRET_KEY
#
# NEVER commit `.dev.vars` or real secret values to git.
# ─────────────────────────────────────────────────────────────

# Stripe — server-side only. Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SIGNING_SECRET

# External event provider adapter
EVENTS_API_BASE_URL=https://api.example-events.com/v1
EVENTS_API_KEY=your_events_api_key_here
EVENTS_API_NAME=demo

# Organizer auth token — use a long random string
ORGANIZER_TOKEN=replace_with_a_long_random_secret

# Public app base URL (used for Stripe success/cancel redirect URLs)
APP_BASE_URL=http://localhost:8787
